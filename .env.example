# Create a .env file here and NEVER share it or commit it to Git
TOMTOM_API_KEY=
# Use a memorable unique password of at least 10 characters
ADMIN_PASSWORD=
# Better option: python -m scripts.make_password_hash, then use ADMIN_PASSWORD_HASH instead
ADMIN_PASSWORD_HASH=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Optional API token for scripts, not needed for browser login
ADMIN_TOKEN=
COOKIE_SECURE=0
DB_PATH=citysync.db
FLOW_INTERVAL_MIN=15
INCIDENT_INTERVAL_MIN=30
TOMTOM_FLOW_MONTHLY_BUDGET=20000
TOMTOM_INCIDENT_MONTHLY_BUDGET=2500
